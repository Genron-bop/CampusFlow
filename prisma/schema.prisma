generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Measurement {
  id        Int      @id @default(autoincrement())
  date      DateTime
  category  String
  label     String?
  value     Float
  source    String?
  createdAt DateTime @default(now())
}
